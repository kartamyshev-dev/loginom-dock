{
  "name": "loginom-dock",
  "description": "Loginom Dock plugins for OpenAI Codex, based on OpenViking.",
  "interface": {
    "displayName": "Loginom Dock"
  },
  "plugins": [
    {
      "name": "openviking-memory",
      "source": {
        "source": "local",
        "path": "./examples/codex-memory-plugin"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity"
    },
    {
      "name": "loginom-dock",
      "source": {
        "source": "local",
        "path": "./plugins/loginom-dock"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
